# --- Base de datos (obligatorio) ---
# Local: Postgres en tu máquina. Producción: URL "pooled" de Neon.
DATABASE_URL=postgres://sunshade:sunshade@localhost:5432/cortinas

# --- Sesión del panel (obligatorio en producción) ---
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=cambia-esto-por-un-secreto-largo

# --- Almacenamiento de fotos (opcional en local) ---
# Sin S3_BUCKET se guardan en .data/uploads. En Vercel usa Cloudflare R2:
# S3_BUCKET=cota-uploads
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Emails (opcional) ---
# Sin clave, los emails se muestran en la consola del servidor.
# RESEND_API_KEY=
# EMAIL_FROM=Cota <avisos@tudominio.com>
# NOTIFY_EMAIL=ventas@tudominio.com
